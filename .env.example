# ============================================================
# KERN — Environment variables template
# NEVER commit real values — use GitHub Secrets + Secret Manager
# ============================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Data region (REQUIRED for Loi 25 compliance — must be ca-central-1)
DATA_REGION=ca-central-1

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kern
DATABASE_URL_SHADOW=postgresql://USER:PASSWORD@HOST:5432/kern_shadow

# Keycloak IAM
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=kern
KEYCLOAK_CLIENT_ID=kern-api
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE

# Secret Manager (AWS)
AWS_REGION=ca-central-1
AWS_SECRET_MANAGER_ARN=arn:aws:secretsmanager:ca-central-1:ACCOUNT:secret:kern/prod

# Audit log (immuable)
AUDIT_LOG_ENCRYPTION_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

# Storage (S3 — Canada region obligatoire)
S3_BUCKET=kern-assets
S3_REGION=ca-central-1

# Redis (BullMQ jobs)
REDIS_URL=redis://localhost:6379

# Email — noreply (system emails)
SMTP_HOST=mail.diofevre.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_EMAIL
SMTP_PASS=REPLACE_WITH_SECRET_MANAGER_VALUE
SMTP_FROM="Kern <noreply.kern@diofevre.com>"

# Email — support (ticket confirmations)
SMTP_SUPPORT_USER=REPLACE_WITH_EMAIL
SMTP_SUPPORT_PASS=REPLACE_WITH_SECRET_MANAGER_VALUE
SMTP_SUPPORT_FROM="Kern Support <support.kern@diofevre.com>"

# NextAuth
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_URL=http://localhost:3000

# SSO Providers (optional — configure per tenant)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=REPLACE_WITH_SECRET_MANAGER_VALUE
