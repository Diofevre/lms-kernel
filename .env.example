# ============================================================
# LMS KERNEL — Environment variables template
# NEVER commit real values — use GitHub Secrets + Secret Manager
# ============================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Data region (REQUIRED for Loi 25 compliance — must be ca-central-1)
DATA_REGION=ca-central-1

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lms_kernel
DATABASE_URL_SHADOW=postgresql://USER:PASSWORD@HOST:5432/lms_kernel_shadow

# Keycloak IAM
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=lms
KEYCLOAK_CLIENT_ID=lms-api
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE

# Secret Manager (AWS)
AWS_REGION=ca-central-1
AWS_SECRET_MANAGER_ARN=arn:aws:secretsmanager:ca-central-1:ACCOUNT:secret:lms/prod

# Audit log (immuable)
AUDIT_LOG_ENCRYPTION_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

# Storage (S3 — Canada region obligatoire)
S3_BUCKET=lms-kernel-assets
S3_REGION=ca-central-1

# Redis (BullMQ jobs)
REDIS_URL=redis://localhost:6379

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASS=REPLACE_WITH_SECRET_MANAGER_VALUE

# BigBlueButton
BBB_URL=https://bbb.example.com/bigbluebutton/
BBB_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE

# LangSmith (agents tracing)
LANGSMITH_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
LANGSMITH_PROJECT=lms-kernel

# Monitoring
SENTRY_DSN=REPLACE_WITH_SECRET_MANAGER_VALUE
