# ============================================================
# ENV pour Codespace / développement local dans le container
# Ces valeurs correspondent aux services docker-compose
# NE PAS utiliser en staging ou production
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ROOT_DOMAIN=localhost
DATA_REGION=ca-central-1

# PostgreSQL (docker-compose service "postgres")
DATABASE_URL=postgresql://kern:kern_dev_password@postgres:5432/kern
DATABASE_URL_DIRECT=postgresql://kern:kern_dev_password@localhost:5432/kern

# Redis (docker-compose service "redis")
REDIS_URL=redis://redis:6379

# Keycloak (docker-compose service "keycloak" — dev-mode, no real secrets needed)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=kern
KEYCLOAK_CLIENT_ID=kern-api
KEYCLOAK_CLIENT_SECRET=dev-secret-not-for-production

# Audit log encryption (dev only — random value, not a real secret)
AUDIT_LOG_ENCRYPTION_KEY=dev-aes-key-32-chars-not-for-prod

# Storage (mocked in dev — no real S3)
S3_BUCKET=kern-dev-local
S3_REGION=ca-central-1

# Monitoring (disabled in dev)
SENTRY_DSN=
