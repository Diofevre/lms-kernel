{
  "name": "@kern/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kern — NestJS API (platform-agnostic backend)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:smoke": "jest --config jest-smoke.config.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy",
    "db:generate": "prisma generate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/static": "7",
    "@kern/audit": "workspace:*",
    "@kern/compliance": "workspace:*",
    "@kern/core": "workspace:*",
    "@kern/iam": "workspace:*",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "bull": "^4.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "fastify": "^4.0.0",
    "helmet": "^7.0.0",
    "jose": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.0.0",
    "prisma": "^5.0.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
