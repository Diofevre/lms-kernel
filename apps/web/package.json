{
  "name": "@kern/web",
  "version": "0.1.0",
  "private": true,
  "description": "Kern — Next.js frontend (WCAG 2.1 AA, Shadcn/UI)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
